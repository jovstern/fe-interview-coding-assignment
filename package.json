{
  "name": "fe-interview-coding-assignment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:server": "npm --prefix external-server run dev",
    "dev:all": "concurrently -n next,server -c blue,green \"npm:dev\" \"npm:dev:server\"",
    "postinstall": "npm --prefix external-server install",
    "format": "prettier --write src external-server",
    "format:check": "prettier --check src external-server",
    "knip": "knip",
    "knip:5": "knip -- --max-show-issues 5"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5"
  }
}
